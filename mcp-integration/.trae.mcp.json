{
  "mcpServers": {
    "orchestrator-tools": {
      "command": "node",
      "args": [
        "${workspaceFolder}/mcp-integration/dist/orchestrator-tools.js"
      ],
      "env": {
        "PROJECT_ROOT": "${workspaceFolder}",
        "SKILL_BUNDLE_PATH": "${workspaceFolder}",
        "START_MCP_TIMEOUT_MS": "120000",
        "RUN_MCP_TIMEOUT_MS": "120000"
      }
    }
  }
}

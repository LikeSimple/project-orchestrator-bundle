# Environment Configuration

# Application
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/myapp

# Authentication
JWT_SECRET=<CHANGE_ME: 32+ random chars>
JWT_EXPIRES_IN=2h

# Third-party APIs (DO NOT commit real values)
STRIPE_SECRET_KEY=<sk_test_xxx>
STRIPE_WEBHOOK_SECRET=<whsec_xxx>

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<CHANGE_ME>
AWS_SECRET_ACCESS_KEY=<CHANGE_ME>

# Monitoring (optional)
SENTRY_DSN=<https://xxx@sentry.io/xxx>

# LLM Integration (optional — leave empty to use MCP Sampling or template fallback)
# Priority: MCP_SAMPLING_ENABLED > direct Provider > template mode (data.llmEnhanced: false)
MCP_SAMPLING_ENABLED=
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
